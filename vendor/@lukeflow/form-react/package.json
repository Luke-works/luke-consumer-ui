{
  "name": "@lukeflow/form-react",
  "version": "0.1.0-alpha.0",
  "description": "React adapter + reference renderer for @lukeflow/form-core.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@lukeflow/form-core": "0.1.0-alpha.0",
    "dompurify": "3.4.12"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
