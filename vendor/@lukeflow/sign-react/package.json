{
  "name": "@lukeflow/sign-react",
  "version": "0.1.0-alpha.0",
  "description": "React components for @lukeflow/sign-core — PDF viewer, signature pad, adopt-signature, and the guided signing ceremony.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@lukeflow/sign-core": "0.1.0-alpha.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-pdf": ">=10",
    "pdfjs-dist": ">=5"
  }
}
