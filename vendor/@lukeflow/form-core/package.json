{
  "name": "@lukeflow/form-core",
  "version": "0.1.0-alpha.0",
  "description": "Headless, framework-agnostic JSON form engine: schema, dependency-graph evaluation, validation, field-type registry.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./quickjs": {
      "types": "./dist/quickjs.d.ts",
      "import": "./dist/quickjs.js",
      "require": "./dist/quickjs.cjs"
    }
  }
}
