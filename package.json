{
  "name": "luke-consumer-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:embed && npm run build:respond && npm run build:render",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:respond": "vite build --config vite.respond.config.ts",
    "build:render": "vite build --config vite.render.config.ts",
    "vendor:respond": "npm run build:respond && node scripts/vendor-bundle.mjs respond",
    "vendor:embed": "npm run build:embed && node scripts/vendor-bundle.mjs embed",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@lukeflow/email-builder": "file:./vendor/@lukeflow/email-builder",
    "@lukeflow/email-core": "file:./vendor/@lukeflow/email-core",
    "@lukeflow/email-react": "file:./vendor/@lukeflow/email-react",
    "@lukeflow/form-builder": "file:./vendor/@lukeflow/form-builder",
    "@lukeflow/form-core": "file:./vendor/@lukeflow/form-core",
    "@lukeflow/form-embed": "file:./vendor/@lukeflow/form-embed",
    "@lukeflow/form-react": "file:./vendor/@lukeflow/form-react",
    "@lukeflow/sign-core": "file:./vendor/@lukeflow/sign-core",
    "@lukeflow/sign-react": "file:./vendor/@lukeflow/sign-react",
    "@lukeflow/workflow-builder": "file:./vendor/@lukeflow/workflow-builder",
    "@lukeflow/workflow-core": "file:./vendor/@lukeflow/workflow-core",
    "@nangohq/frontend": "^0.70.9",
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.9",
    "@sentry/react": "^10.59.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.3.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.10",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^5.4.296",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.3.5",
    "react-helmet-async": "^2.0.5",
    "react-pdf": "^10.4.1",
    "react-router": "^7.18.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.0.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@lukeflow/form-core": "file:./vendor/@lukeflow/form-core",
    "@lukeflow/form-react": "file:./vendor/@lukeflow/form-react",
    "@lukeflow/form-builder": "file:./vendor/@lukeflow/form-builder",
    "react-helmet-async": {
      "react": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
