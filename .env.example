VITE_AUTH_API_URL=http://localhost:8083
# luke-agents service base URL (hosts the AI form builder under /agents/form).
# Defaults to the hosted deployment if unset.
VITE_FORM_AGENT_URL=https://luke-agents.onrender.com
# luke-agents base URL for the AI workflow builder ("LukeBuilds", under
# /agents/workflow). Same service as the form agent — unset → falls back to
# VITE_FORM_AGENT_URL. Set only if you host the workflow agent separately.
# VITE_WORKFLOW_AGENT_URL=https://luke-agents.onrender.com
# luke-signature-engine base URL (e-signature API). Standalone dev runs on :8090.
# Unset → falls back to VITE_AUTH_API_URL (post-merge, routed through the gateway).
VITE_SIGNATURES_API_URL=http://localhost:8090
# Forms autofill: SUPPRESSED by default on every input. Set to "true" to let browsers /
# password managers autofill forms normally. (Build-time; controls the dashboard app — the
# embedded-form bundle is vendored into core-engine and built separately.)
# VITE_FORMS_ALLOW_AUTOFILL=true
