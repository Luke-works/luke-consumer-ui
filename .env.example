VITE_AUTH_API_URL=http://localhost:8083
# NOTE: there is no luke-agents URL here any more. Every AI call now goes through
# core-engine at VITE_AUTH_API_URL/api/ai, which authenticates the caller and attaches the
# WORKSPACE'S OWN provider key (bring-your-own-key). The browser never reaches the agents
# service, and the agents service URL is server-side config (LUKE_AI_AGENTS_URL on the
# engine). Each workspace connects its provider in the app, at /ai.
# luke-signature-engine base URL (e-signature API). Standalone dev runs on :8090.
# Unset → falls back to VITE_AUTH_API_URL (post-merge, routed through the gateway).
VITE_SIGNATURES_API_URL=http://localhost:8090
# Post-MVP capability visibility. The MVP surface is Forms + Email + Access only; Phone,
# Signatures and Workflow are HIDDEN by default (nav, routes, AND the access/request/catalog
# lists). Set the matching flag to "true" to reveal one once it's ready to ship. (Documents has
# no UI capability, so there is nothing to gate for it.)
# VITE_PHONE_ENABLED=true
# VITE_SIGNATURES_ENABLED=true
# VITE_WORKFLOW_ENABLED=true
# Analytics section (form-submission dashboard, built on @lukeflow/analytics-*). Post-MVP and
# HIDDEN by default (nav + route). Not a backend capability yet — it charts FORMS data and is
# gated on FORMS access, so nothing is persisted. Set to "true" to reveal it.
# VITE_ANALYTICS_ENABLED=true
# Forms autofill: SUPPRESSED by default on every input. Set to "true" to let browsers /
# password managers autofill forms normally. (Build-time; controls the dashboard app — the
# embedded-form bundle is vendored into core-engine and built separately.)
# VITE_FORMS_ALLOW_AUTOFILL=true
# Observability (Sentry). Client error/perf reporting is a NO-OP unless a DSN is set, so
# these are unset in dev. In qa/prod, set the DSN to enable Sentry; the trace sample rate
# (0..1) tunes performance tracing; the release tags events to a build for triage.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# VITE_SENTRY_TRACES_RATE=0.1
# VITE_RELEASE=luke-consumer-ui@1.0.0
